{
    "name":  "@solid-tracker/backend-api",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Solid Tracker backend REST API",
    "license":  "UNLICENSED",
    "scripts":  {
                    "build":  "nest build",
                    "format":  "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
                    "start":  "nest start",
                    "start:dev":  "nest start --watch",
                    "start:debug":  "nest start --debug --watch",
                    "start:prod":  "node dist/src/main.js",
                    "lint":  "eslint \"{src,test}/**/*.ts\"",
                    "lint:fix":  "eslint \"{src,test}/**/*.ts\" --fix",
                    "typecheck":  "tsc --noEmit",
                    "test":  "jest",
                    "test:watch":  "jest --watch",
                    "test:cov":  "jest --coverage",
                    "test:e2e":  "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
                    "prisma:format":  "prisma format --config prisma.config.ts",
                    "prisma:validate":  "prisma validate --config prisma.config.ts",
                    "prisma:generate":  "prisma generate --config prisma.config.ts",
                    "prisma:migrate:dev":  "prisma migrate dev --config prisma.config.ts",
                    "prisma:migrate:status":  "prisma migrate status --config prisma.config.ts",
                    "prisma:seed":  "prisma db seed --config prisma.config.ts",
                    "prisma:studio":  "prisma studio --config prisma.config.ts",
                    "prebuild":  "prisma generate --config prisma.config.ts",
                    "identity:create-admin":  "tsx src/identity/cli/create-platform-admin.ts"
                },
    "jest":  {
                 "moduleFileExtensions":  [
                                              "js",
                                              "json",
                                              "ts"
                                          ],
                 "rootDir":  "src",
                 "testRegex":  ".*\\.spec\\.ts$",
                 "transform":  {
                                   "^.+\\.(t|j)s$":  "ts-jest"
                               },
                 "collectCoverageFrom":  [
                                             "**/*.(t|j)s"
                                         ],
                 "coverageDirectory":  "../coverage",
                 "testEnvironment":  "node"
             },
    "dependencies":  {
                         "@nestjs/common":  "^11.1.28",
                         "@nestjs/config":  "^4.0.4",
                         "@nestjs/core":  "^11.1.28",
                         "@nestjs/jwt":  "11.0.2",
                         "@nestjs/platform-express":  "^11.1.28",
                         "@nestjs/swagger":  "^11.4.5",
                         "@nestjs/terminus":  "^11.1.1",
                         "@prisma/adapter-pg":  "7.8.0",
                         "@prisma/client":  "7.8.0",
                         "class-transformer":  "^0.5.1",
                         "class-validator":  "^0.15.1",
                         "dotenv":  "17.4.2",
                         "helmet":  "^8.3.0",
                         "ioredis":  "^5.11.1",
                         "joi":  "^18.2.3",
                         "pg":  "^8.22.0",
                         "reflect-metadata":  "^0.2.2",
                         "rxjs":  "^7.8.2"
                     },
    "devDependencies":  {
                            "@eslint/js":  "10.0.1",
                            "@nestjs/cli":  "^11.0.24",
                            "@nestjs/schematics":  "^11.1.0",
                            "@nestjs/testing":  "^11.1.28",
                            "@types/express":  "^5.0.6",
                            "@types/jest":  "^30.0.0",
                            "@types/node":  "^26.1.1",
                            "@types/pg":  "^8.20.0",
                            "@types/supertest":  "^7.2.0",
                            "eslint":  "^10.7.0",
                            "eslint-config-prettier":  "^10.1.8",
                            "eslint-plugin-prettier":  "^5.5.6",
                            "globals":  "^17.7.0",
                            "jest":  "^30.4.2",
                            "prettier":  "^3.9.5",
                            "prisma":  "7.8.0",
                            "source-map-support":  "^0.5.21",
                            "supertest":  "^7.2.2",
                            "ts-jest":  "^29.4.11",
                            "ts-loader":  "^9.6.2",
                            "ts-node":  "^10.9.2",
                            "tsconfig-paths":  "^4.2.0",
                            "tsx":  "4.23.1",
                            "typescript":  "^5.9.3",
                            "typescript-eslint":  "^8.63.0"
                        }
}
